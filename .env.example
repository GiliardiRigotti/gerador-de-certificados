# =============================================================================
# Exemplo de configuracao. Copie para .env e ajuste os valores:
#
#   cp .env.example .env
#
# O config.py carrega o .env da raiz automaticamente na inicializacao. Basta
# criar o arquivo e subir o app normalmente:
#
#   streamlit run app.py
#
# Variaveis ja definidas no ambiente tem precedencia sobre o arquivo, entao em
# producao o servidor (ou o docker run -e) continua no comando.
#
# O .env esta no .gitignore e nunca deve ser commitado.
# Todas as variaveis abaixo sao OPCIONAIS: sem elas o app usa os padroes
# definidos em config.py.
# =============================================================================


# --- Identidade do evento ----------------------------------------------------

# Nome do evento impresso no certificado e usado como remetente padrao.
EVENTO_PADRAO="9ª Conferência Municipal de Saúde de Balneário Camboriú"

# URL publica de validacao embutida no QR Code. O codigo do certificado e
# anexado automaticamente (?codigo=XXXX), entao NAO inclua query string aqui.
# Em producao, aponte para o dominio real do servidor.
# Para testar o QR pelo celular na rede local, use o IP da maquina (nao
# localhost) e a porta do Streamlit, ex.: http://192.168.0.10:8501/
VALIDATION_BASE_URL=https://certificados.bc.sc.gov.br/


# --- Login administrativo ----------------------------------------------------

# Credenciais da area do organizador. Preencha as duas: sem elas o app cai nas
# credenciais de desenvolvimento do config.py, que nao devem ir para producao.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Alternativa mais segura: em vez de ADMIN_PASSWORD em texto puro, guarde o
# hash SHA-256 da senha. Se preenchido, tem precedencia sobre ADMIN_PASSWORD.
# Gere com:  printf '%s' 'sua-senha' | shasum -a 256
# ADMIN_PASSWORD_SHA256=


# --- Armazenamento -----------------------------------------------------------

# Caminho do banco SQLite e da pasta de PDFs gerados. Os padroes ficam na raiz
# do projeto; no container o Dockerfile aponta ambos para /data.
DATABASE_PATH=certificados.db
OUTPUT_DIR=certificados_gerados


# --- Envio de certificado por e-mail -----------------------------------------
#
# Sem SMTP_HOST definido, o envio fica DESLIGADO e a geracao de certificados
# segue funcionando normalmente. Preencha o bloco inteiro para ativar.
# Use `python testar_smtp.py` para diagnosticar a conexao antes de usar no app.

# Servidor SMTP. Ex.: smtp.gmail.com, smtp.office365.com
SMTP_HOST=
SMTP_USER=usuario@bc.sc.gov.br

# Senha do SMTP. No Gmail/Office365 com 2FA isto e uma "senha de app",
# nao a senha normal da conta.
SMTP_PASSWORD=

# true  = SSL direto (porta 465, padrao)
# false = STARTTLS   (porta 587)
SMTP_USE_SSL=true

# Opcional: se omitido, acompanha o SMTP_USE_SSL (465 para SSL, 587 para
# STARTTLS). So preencha para uma porta fora do padrao.
# SMTP_PORT=465

# Remetente exibido. Se SMTP_FROM_EMAIL ficar vazio, usa o SMTP_USER.
# Muitos servidores exigem que o remetente seja o mesmo do usuario autenticado.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Comissão Organizadora"

# Timeout da conexao SMTP em segundos.
SMTP_TIMEOUT=30

# Assunto do e-mail. Aceita os marcadores {evento} e {nome}.
EMAIL_ASSUNTO="Seu certificado - {evento}"
